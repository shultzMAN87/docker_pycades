# Скопируйте в .env и заполните под себя:  cp .env.example .env
# Файл .env в git не попадает (см. .gitignore).

# Порт, на котором сервис виден с хоста
APP_PORT=8011

# Версия pycades (тег из https://github.com/CryptoPro/pycades)
PYCADES_REF=v0.1.70300
UBUNTU_VERSION=24.04

# Отпечаток (SHA-1) сертификата по умолчанию.
# Пусто — берётся первый действующий сертификат с закрытым ключом.
# Узнать: curl http://127.0.0.1:8011/certificates
# Пример: CERT_THUMBPRINT=1fe3ad777ab2828e91a427709210d40b42985c55
CERT_THUMBPRINT=

# Пин-код ключевого контейнера. НИКОГДА не коммитьте реальный пин.
CERT_PIN=

# Установить при старте тестовый сертификат pycades-test (действует до 2050).
# Удобно, чтобы прогнать selftest без своего сертификата.
SETUP_TEST_CERT=false

# Пароль от файла .pfx, если вы положили его в keys/
PFX_PASSWORD=

# Проверять цепочку и срок действия сертификата перед подписью.
# Для тестового/просроченного сертификата оставьте false.
CHECK_CERTIFICATE=false

# Серийный номер лицензии КриптоПро CSP.
# Без него CSP работает 90 дней в демо-режиме.
CSP_LICENSE=
